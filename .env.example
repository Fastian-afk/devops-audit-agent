# Environment Variables — Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ============================================================
# LLM Provider Selection
# Set PROVIDER to either "gemini" or "openai"
# ============================================================
PROVIDER=gemini

# ============================================================
# Google Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# OpenAI API Key (alternative provider)
# Obtain from: https://platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# Model Selection (optional — defaults shown)
# ============================================================
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Groq API (OpenAI-compatible alternative)
# ============================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ============================================================
# Agent Behavior Tuning (optional)
# ============================================================
# Maximum number of agent reasoning turns before forced completion
AGENT_MAX_TURNS=18

# Timeout in seconds for cloning a repository
CLONE_TIMEOUT_SECONDS=120

# Timeout in seconds for running ruff / other subprocess tools
TOOL_SUBPROCESS_TIMEOUT=30

# Enable verbose trace logging to stderr (true/false)
AGENT_VERBOSE=true
